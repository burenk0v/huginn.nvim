{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Huginn SDET configuration",
  "type": "object",
  "properties": {
    "python": {
      "type": "object",
      "properties": {
        "package_manager": { "type": "string" },
        "formatter": { "type": "string" },
        "linter": { "type": "string" },
        "type_checker": { "type": "string" }
      },
      "additionalProperties": true
    },
    "testing": {
      "type": "object",
      "properties": {
        "runner": { "type": "string" },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "additionalProperties": true
    },
    "ai": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "instructions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
