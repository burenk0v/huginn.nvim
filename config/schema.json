{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Huginn SDET configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "python": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package_manager": { "type": "string" },
        "formatter": { "type": "string" },
        "linter": { "type": "string" },
        "type_checker": { "type": "string" }
      }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework": { "type": "string", "minLength": 1 },
        "frameworks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pytest": { "type": "object" }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runner": { "type": "string", "minLength": 1 }
            }
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "keymaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "type": "string", "enum": ["notepadpp", "none"] },
        "run": { "type": "string" },
        "run_file": { "type": "string" },
        "check": { "type": "string" },
        "profile": { "type": "string" },
        "nearest": { "type": "string" },
        "debug": { "type": "string" },
        "args": { "type": "string" }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "instructions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["openai_compatible"], "minLength": 1 },
              "endpoint": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "auth": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "enum": ["oidc"], "minLength": 1 },
                  "issuer": { "type": "string", "minLength": 1 },
                  "client_id": { "type": "string", "minLength": 1 },
                  "scope": { "type": "string", "minLength": 1 }
                },
                "required": ["type", "issuer", "client_id"]
              }
            },
            "required": ["type"]
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "budget_tokens": { "type": "number", "minimum": 0 },
            "cost_per_million_tokens": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
